{
	"name": "night-owl",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "npm run db:generate && next build",
		"start": "next start",
		"lint": "eslint .",
		"db:validate": "prisma validate --config=src/shared/lib/db/prisma.config.ts",
		"db:format": "prisma format --config=src/shared/lib/db/prisma.config.ts",
		"db:generate": "prisma generate --config=src/shared/lib/db/prisma.config.ts",
		"db:push": "prisma db push --config=src/shared/lib/db/prisma.config.ts",
		"db:push:loss": "prisma db push --config=src/shared/lib/db/prisma.config.ts --accept-data-loss",
		"db:reset": "prisma db push --config=src/shared/lib/db/prisma.config.ts --force-reset",
		"db:studio": "prisma studio --config=src/shared/lib/db/prisma.config.ts"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.6.0",
		"@prisma/client": "^7.6.0",
		"@reduxjs/toolkit": "^2.11.2",
		"@supabase/ssr": "^0.10.0",
		"@supabase/supabase-js": "^2.101.1",
		"@svgr/webpack": "^8.1.0",
		"@tanstack/react-query": "^5.96.2",
		"dotenv": "^17.4.0",
		"framer-motion": "^12.38.0",
		"next": "^16.2.2",
		"next-cloudinary": "^6.17.5",
		"pg": "^8.20.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-redux": "^9.2.0",
		"slugify": "^1.6.6"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^25.5.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.1",
		"eslint-config-next": "^16.2.2",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-perfectionist": "^5.8.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"prisma": "^7.6.0",
		"sass": "^1.99.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0"
	}
}

{
	"name": "night-owl",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "npm run db:generate && next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "next typegen && tsc --noEmit --pretty false",
		"check": "npm run lint && npm run typecheck",
		"check:build": "npm run check && npm run build",
		"prepush": "npm run check && npm run test:run",
		"db:validate": "prisma validate --config=src/shared/lib/db/prisma.config.ts",
		"db:format": "prisma format --config=src/shared/lib/db/prisma.config.ts",
		"db:generate": "prisma generate --config=src/shared/lib/db/prisma.config.ts",
		"db:push": "prisma db push --config=src/shared/lib/db/prisma.config.ts",
		"db:push:loss": "prisma db push --config=src/shared/lib/db/prisma.config.ts --accept-data-loss",
		"db:reset": "prisma db push --config=src/shared/lib/db/prisma.config.ts --force-reset",
		"db:studio": "prisma studio --config=src/shared/lib/db/prisma.config.ts",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@reduxjs/toolkit": "2.13.0",
		"@supabase/ssr": "0.12.7",
		"@supabase/supabase-js": "2.117.2",
		"@svgr/webpack": "8.1.0",
		"@tanstack/react-query": "5.104.1",
		"dotenv": "18.0.5",
		"framer-motion": "14.0.0",
		"next": "16.3.8",
		"next-cloudinary": "6.19.3",
		"pg": "8.23.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-redux": "9.3.0",
		"slugify": "1.6.9"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "5.10.0",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.0",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-perfectionist": "5.12.1",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"jsdom": "29.1.1",
		"prisma": "7.10.0",
		"sass": "1.105.1",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.3"
	}
}

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  parameterValues ProductParameterValue[]

  @@index([categoryId])
}

model ParameterValue {
  id    String @id @default(cuid())
  value String
  slug  String

  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])

  products ProductParameterValue[]

  @@unique([parameterId, value])
  @@unique([parameterId, slug])
  @@index([parameterId])
}

model ProductParameterValue {
  id               String @id @default(cuid())
  productId        String
  parameterValueId String

  product        Product        @relation(fields: [productId], references: [id])
  parameterValue ParameterValue @relation(fields: [parameterValueId], references: [id])

  @@unique([productId, parameterValueId])
  @@index([productId])
  @@index([parameterValueId])
}

model Parameter {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories CategoryParameter[]
  values     ParameterValue[]
}

model CategoryParameter {
  id          String @id @default(cuid())
  categoryId  String
  parameterId String

  category  Category  @relation(fields: [categoryId], references: [id])
  parameter Parameter @relation(fields: [parameterId], references: [id])

  @@unique([categoryId, parameterId])
  @@index([categoryId])
  @@index([parameterId])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  parentId String?
  slug     String     @unique
  parent   Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children Category[] @relation("Subcategories")

  products Product[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  CategoryParameter CategoryParameter[]

  @@index([parentId])
}
